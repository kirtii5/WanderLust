<% layout("/layouts/boilerplate") %>

  <body>

    <div class="container mt-3">

      <!-- FILTER BAR WRAPPER -->
      <div id="filters-wrapper">

        <!-- LEFT ARROW -->
        <button id="scroll-left" class="scroll-btn">&lt;</button>

        <!-- FILTERS -->
        <div id="filters">
          <a href="/listings/filter/trending">
            <div class="filter"><i class="fa-solid fa-fire"></i>
              <p>Trending</p>
            </div>
          </a>
          <a href="/listings/filter/rooms">
            <div class="filter"><i class="fa-solid fa-bed"></i>
              <p>Rooms</p>
            </div>
          </a>
          <a href="/listings/filter/iconic cities">
            <div class="filter"><i class="fa-solid fa-mountain-city"></i>
              <p>Iconic Cities</p>
            </div>
          </a>
          <a href="/listings/filter/castle">
            <div class="filter"><i class="fa-brands fa-fort-awesome"></i>
              <p>Castle</p>
            </div>
          </a>
          <a href="/listings/filter/mountain views">
            <div class="filter"><i class="fa-solid fa-mountain-sun"></i>
              <p>Mountain Views</p>
            </div>
          </a>
          <a href="/listings/filter/camping">
            <div class="filter"><i class="fa-solid fa-tent"></i>
              <p>Camping</p>
            </div>
          </a>
          <a href="/listings/filter/amazing nature">
            <div class="filter"><i class="fa-solid fa-person-swimming"></i>
              <p>Amazing Nature</p>
            </div>
          </a>
          <a href="/listings/filter/farms">
            <div class="filter"><i class="fa-solid fa-tractor"></i>
              <p>Farms</p>
            </div>
          </a>
          <a href="/listings/filter/arctic">
            <div class="filter"><i class="fa-solid fa-snowflake"></i>
              <p>Arctic</p>
            </div>
          </a>
          <a href="/listings/filter/boats">
            <div class="filter"><i class="fa-solid fa-ship"></i>
              <p>Boats</p>
            </div>
          </a>
          <a href="/listings/filter/domes">
            <div class="filter"><i class="fa-solid fa-igloo"></i>
              <p>Domes</p>
            </div>
          </a>
        </div>

        <!-- RIGHT ARROW -->
        <button id="scroll-right" class="scroll-btn">&gt;</button>

      </div>

      <!-- TAX SWITCH -->
      <div class="tax-switch">
        <div class="form-check-reverse form-switch">
          <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
          <label class="form-check-label" for="flexSwitchCheckDefault">Display Total after Taxes</label>
        </div>
      </div>

      <!-- CARD GRID -->
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 mt-3">
        <% for(let listing of allListings){ %>
          <div class="col mb-4">
            <a href="/listings/<%= listing._id %>" class="listing-link">
              <div class="card listing-card">
                <img src="<%= listing.image.url %>" class="card-img-top" alt="listing-img" style="height: 20rem;">
                <div class="card-body">
                  <p class="card-text">
                    <b>
                      <%= listing.title %>
                    </b><br>
                    ₹<%= listing.price.toLocaleString("en-IN") %> / Night
                      <i class="tax-info">&nbsp;+18% GST</i>
                  </p>
                </div>
              </div>
            </a>
          </div>
          <% } %>
      </div>

    </div>

    <script>
      // TAX TOGGLE
      document.getElementById("flexSwitchCheckDefault").addEventListener("click", () => {
        document.querySelectorAll(".tax-info").forEach(el => {
          el.style.display = el.style.display === "inline" ? "none" : "inline";
        });
      });

      // SCROLL BUTTONS
      const filters = document.getElementById("filters");

      document.getElementById("scroll-left").onclick = () => {
        filters.scrollBy({ left: -250, behavior: "smooth" });
      };

      document.getElementById("scroll-right").onclick = () => {
        filters.scrollBy({ left: 250, behavior: "smooth" });
      };
    </script>

  </body>